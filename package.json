{
  "name": "pepite-app",
  "version": "2.0.0",
  "description": "Pépite — Dénichez, valorisez, vendez. Application smartphone Android & Apple iOS pour la revente Vinted & Leboncoin",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cap:init": "npx @capacitor/cli init \"Pépite\" \"com.pepite.app\" --web-dir .",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:add:ios": "npx @capacitor/cli add ios",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:open:android": "npx @capacitor/cli open android",
    "cap:open:ios": "npx @capacitor/cli open ios",
    "build:apk": "npx @capacitor/cli copy android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "pepite",
    "vinted",
    "leboncoin",
    "android",
    "ios",
    "pwa",
    "capacitor",
    "resale",
    "second-hand"
  ],
  "author": "Pépite Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  }
}
